# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable (anon-level) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Supabase secret / service-role key — SERVER ONLY.
# Required for /admin/employees/new (provisioning users via supabase.auth.admin.createUser).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_KEY

# --- Google Calendar (optional) ---
# When set, the dashboard fetches today's standup meeting URLs from Google Calendar
# and shows a "Join meeting" button on each standup slot. If unset, that button
# simply doesn't appear — everything else still works.

# Service account email (from the JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key (from the JSON key file).
# IMPORTANT: paste the full multi-line key. In .env files, replace real newlines
# with the literal characters \n (backslash-n) and wrap the whole value in
# double quotes. Example:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# The calendar to read standup events from. Either a primary email
# (e.g. you@example.com) or a custom calendar ID
# (e.g. c_abc123@group.calendar.google.com).
GOOGLE_CALENDAR_ID=

# Optional — only consider events whose summary contains this keyword
# (case-insensitive). Leave empty to match purely by start time.
GOOGLE_CALENDAR_EVENT_KEYWORD=standup
